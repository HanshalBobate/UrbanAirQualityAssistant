# Optional: Set your Gemini API key for live GenAI recommendations & chat
# Without this key, the app runs in Built-in Local Advisor Mode (or you can enter a key in the UI Settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Ground-station API keys (Sensor.Community works keyless automatically)
OPENAQ_API_KEY=
PURPLEAIR_API_KEY=

PORT=3001
